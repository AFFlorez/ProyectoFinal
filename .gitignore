# Proyecto de dengue: insumos y archivos generados que se mantienen localmente.
# Estas reglas no eliminan archivos ya registrados ni su historial en Git.
# Solo versionar los CSV reducidos y su registro de conversión.
/DataRaw/*
!/DataRaw/Datos_*_210.csv
!/DataRaw/manifiesto_reduccion.json
!/DataRaw/resumen_reduccion.csv
/DataRawOriginal/
/ShapeMunicipios/
/DatosProcesados/
/ResultadosModelos/
/training.csv
/validation.csv
/test.csv

# Entorno local de Jupyter, ejecuciones de revisión y cachés.
/.jupyter-local/

# Modelos, escaladores, tensores y copias de datos fuera de las carpetas anteriores.
