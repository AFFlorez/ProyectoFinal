*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# Se conservan el notebook principal, los scripts, las dependencias,
# la documentación y MunicipiosValledelCauca.csv (catálogo pequeño).
/ShapeMunicipios/CLIMA_DENGUE_VALLE-20261012T225252Z-1-001.zip
/ShapeMunicipios/SHP_MGN2018_INTGRD_MPIO.zip
/ShapeMunicipios/SHP_MGN2018_INTGRD_MPIO/

# Paquete del modelo seleccionado que sí se incluye en el repositorio.
!/ModeloSeleccionado/modelo.keras
!/ModeloSeleccionado/modelo.joblib
!/ModeloSeleccionado/modelo.ubj
!/ModeloSeleccionado/preprocesamiento.joblib
!/ModeloSeleccionado/entradas_ejemplo_validacion.npz
!/ModeloSeleccionado/modelos/*.keras

