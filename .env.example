# Parámetros de la aplicación. Copiar a .env en la raíz y ajustar
# (infra/docker/docker-compose.yml lo lee automáticamente).
# En AWS, la plantilla de CloudFormation escribe estos valores en /opt/dengue-app/.env.

# Título que muestra la interfaz web.
APP_TITULO=Pronóstico semanal de dengue · Valle del Cauca

# Puerto público en el equipo anfitrión (docker compose) y procesos de uvicorn.
PUERTO_PUBLICO=8000
WORKERS=1

# Paquete del modelo (configuracion.json, modelo.keras, preprocesamiento.joblib, sha256.json).
# Rutas relativas a la raíz del repositorio dentro del contenedor (/srv).
MODELO_DIR=modelos
# Opcional: URL https de un .zip con el paquete, si el modelo no está en el repositorio.
MODELO_URL=
# Verificar la huella SHA-256 del modelo y del preprocesamiento al iniciar.
VERIFICAR_SHA256=true

# Carpeta con semanal_training.csv, semanal_validation.csv y semanal_test.csv (punto 11 del notebook).
DATOS_DIR=data/DatosProcesados

# Niveles de alerta: percentiles de los casos semanales de 2007-2021 de cada municipio.
ALERTA_PERCENTIL_MODERADO=75
ALERTA_PERCENTIL_ALTO=90

# Máximo de filas aceptadas al pronosticar con datos propios (CSV o JSON).
MAX_SEMANAS_ENTRADA=2000

# DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# Orígenes permitidos para consumir la API desde otro dominio (separados por coma).
CORS_ORIGENES=*

# Puerto de MLflow en el mismo equipo. Si se indica, la interfaz muestra el enlace
# «Experimentos (MLflow)». Vacío para ocultarlo.
MLFLOW_PUERTO=5000
